# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram User ID of the admin who receives notifications and can unban
# (Can be comma-separated if you have multiple admins, e.g. 123456789,987654321)
ADMIN_ID=123456789

# Path to persistent database (in Railway volume, use /app/data/bot.db)
DB_PATH=/app/data/bot.db

# (Optional) ID of a channel or group to forward ban logs to
LOG_CHANNEL_ID=
